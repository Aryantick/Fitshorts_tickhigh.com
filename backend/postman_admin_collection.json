            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Orange Senior Reviewer\",\n  \"description\": \"Custom role profile created from Admin UI for Orange BF team\",\n  \"client_id\": 2,\n  \"permissions\": {\n    \"pages\": [\n      \"dashboard\",\n      \"moderation\",\n      \"reels\"\n    ],\n    \"actions\": {\n      \"canApproveReel\": true,\n      \"canRejectReel\": true,\n      \"canSuspendReel\": false,\n      \"canBlockUser\": false,\n      \"isReadOnly\": false\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/roles",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "roles"]
            }
          }
        },
