              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"Copyright issue\"\n}" },
            "url": { "raw": "{{baseUrl}}/admin/reels/1/suspend", "host": ["{{baseUrl}}"], "path": ["admin", "reels", "1", "suspend"] }
          }
        },
        {
          "name": "Delete Reel",
          "request": {
            "method": "DELETE",
