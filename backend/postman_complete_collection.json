{
  "info": {
    "_postman_id": "wellness360-fitshort-complete-platform",
    "name": "Wellness360 FitShort - Complete Platform API Collection (Admin + User + Telecom)",
    "description": "Complete Postman collection for the entire Wellness360 platform, containing all Admin Portal APIs, End-User Reels, Feed, Social Actions, Notifications, Music Library, Multi-Tenant Telecom Subscriptions, and OTP Flows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "userToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "clientSubdomain",
      "value": "obf",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "👑 1. ADMIN - Auth & Profile",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.data.token);",
                  "    console.log('adminToken auto-saved:', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"superadmin@tickhigh.com\",\n  \"password\": \"ChangeThisPassword123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/login", "host": ["{{baseUrl}}"], "path": ["admin", "login"] }
          }
        },
        {
          "name": "Get Current Admin Profile (Me)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/me", "host": ["{{baseUrl}}"], "path": ["admin", "me"] }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"ChangeThisPassword123!\",\n  \"newPassword\": \"NewPassword123!\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/change-password", "host": ["{{baseUrl}}"], "path": ["admin", "change-password"] }
          }
        }
      ]
    },
    {
      "name": "🎛️ 2. ADMIN - Dynamic Roles & Permissions",
      "item": [
        {
          "name": "Get All Roles (System & Custom)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/roles", "host": ["{{baseUrl}}"], "path": ["admin", "roles"] }
          }
        },
        {
          "name": "Get Role By ID",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/roles/1", "host": ["{{baseUrl}}"], "path": ["admin", "roles", "1"] }
          }
        },
        {
          "name": "Create Custom Role (UI Driven)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Orange Senior Reviewer\",\n  \"description\": \"Custom moderation profile for Orange BF\",\n  \"client_id\": 2,\n  \"permissions\": {\n    \"pages\": [\"dashboard\", \"moderation\", \"reels\"],\n    \"actions\": {\"canApproveReel\": true, \"canRejectReel\": true, \"canSuspendReel\": false, \"isReadOnly\": false}\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/roles", "host": ["{{baseUrl}}"], "path": ["admin", "roles"] }
          }
        },
        {
          "name": "Update Role Permissions",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{adminToken}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Orange Senior Reviewer Updated\",\n  \"permissions\": {\n    \"pages\": [\"dashboard\", \"moderation\", \"reels\", \"categories\"],\n    \"actions\": {\"canApproveReel\": true, \"canRejectReel\": true, \"canSuspendReel\": true, \"isReadOnly\": false}\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/admin/roles/6", "host": ["{{baseUrl}}"], "path": ["admin", "roles", "6"] }
          }
        },
        {
          "name": "Delete Custom Role",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{adminToken}}" }],
            "url": { "raw": "{{baseUrl}}/admin/roles/6", "host": ["{{baseUrl}}"], "path": ["admin", "roles", "6"] }
          }
        }
      ]
    },
