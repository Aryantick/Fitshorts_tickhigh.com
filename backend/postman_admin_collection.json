                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Orange Senior Reviewer Updated\",\n  \"description\": \"Updated role permissions from UI\",\n  \"permissions\": {\n    \"pages\": [\n      \"dashboard\",\n      \"moderation\",\n      \"reels\",\n      \"categories\"\n    ],\n    \"actions\": {\n      \"canApproveReel\": true,\n      \"canRejectReel\": true,\n      \"canSuspendReel\": true,\n      \"canBlockUser\": false,\n      \"isReadOnly\": false\n    }\n  }\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/roles/6",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "roles", "6"]
            }
          }
        },
        {
          "name": "Delete Custom Role",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
