    {
      "name": "📱 11. USER - Subscription & Telecom OTP",
      "item": [
        {
          "name": "1. Check MSISDN Status",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-client-subdomain", "value": "{{clientSubdomain}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"msisdn\": \"22674031858\"\n}" },
            "url": { "raw": "{{baseUrl}}/msisdn/check", "host": ["{{baseUrl}}"], "path": ["msisdn", "check"] },
            "description": "Checks if the MSISDN is active, subscribed, or new."
          }
        },
        {
          "name": "2. Select Subscription Plan",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-client-subdomain", "value": "{{clientSubdomain}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"msisdn\": \"22674031858\",\n  \"planId\": \"FDaily\"\n}" },
            "url": { "raw": "{{baseUrl}}/plan/select", "host": ["{{baseUrl}}"], "path": ["plan", "select"] }
          }
        },
        {
          "name": "3. Send Subscription OTP (New Users)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-client-subdomain", "value": "{{clientSubdomain}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"msisdn\": \"22674031858\"\n}" },
            "url": { "raw": "{{baseUrl}}/otp/send", "host": ["{{baseUrl}}"], "path": ["otp", "send"] }
          }
        },
        {
          "name": "4. Verify Subscription OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('userToken', jsonData.data.token);",
                  "    console.log('userToken auto-saved:', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-client-subdomain", "value": "{{clientSubdomain}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"msisdn\": \"22674031858\",\n  \"otp\": \"1234\"\n}" },
            "url": { "raw": "{{baseUrl}}/otp/verify", "host": ["{{baseUrl}}"], "path": ["otp", "verify"] }
          }
        },
        {
          "name": "5. Send Auth OTP (Existing Users)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "x-client-subdomain", "value": "{{clientSubdomain}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"msisdn\": \"22674031858\"\n}" },
            "url": { "raw": "{{baseUrl}}/auth-otp/send", "host": ["{{baseUrl}}"], "path": ["auth-otp", "send"] }
          }
        },
        {
          "name": "6. Verify Auth OTP",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('userToken', jsonData.data.token);",
                  "}"
                ],
