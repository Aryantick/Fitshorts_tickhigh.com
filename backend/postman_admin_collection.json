{
  "info": {
    "_postman_id": "wellness360-admin-portal-v1",
    "name": "Wellness360 - Admin Portal API Collection (Phase 1 MVP)",
    "description": "Comprehensive Postman collection for Wellness360 Admin Portal, including Multi-Tenant Client Scopes, Reel Moderation Queue, Dynamic Roles & Permissions, User Management, Categories, Leaderboard, Audit Logs, and Bulk Music Upload.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "adminToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Admin Auth & Profile",
      "item": [
        {
          "name": "Admin Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "var jsonData = pm.response.json();",
                  "if (jsonData.data && jsonData.data.token) {",
                  "    pm.collectionVariables.set('adminToken', jsonData.data.token);",
                  "    console.log('adminToken saved automatically:', jsonData.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"identifier\": \"superadmin@tickhigh.com\",\n  \"password\": \"ChangeThisPassword123!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/login",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "login"]
            },
            "description": "Logs in an admin with Email/Username and Password, saves JWT token automatically to collection variables."
          }
        },
        {
          "name": "Get Current Admin Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/admin/me",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "me"]
            },
            "description": "Returns current logged in admin session profile, assigned client scope, and dynamic permissions."
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminToken}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"currentPassword\": \"ChangeThisPassword123!\",\n  \"newPassword\": \"NewSecurePass2026!\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/change-password",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "change-password"]
            }
          }
        }
      ]
    },
    {
